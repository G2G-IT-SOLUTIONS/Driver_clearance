# ---------- Server ----------
PORT=3001
# In Docker this line is ignored: docker-compose.yml sets PORT and DATABASE_URL itself. Used only for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/g2g
JWT_SECRET=change-me-to-a-long-random-string
# PUBLIC address drivers use in the browser, e.g. https://letters.example.com  (Chapa sends the driver back here after paying)
# Local development: http://localhost:5173
PUBLIC_URL=http://localhost:5173
# Public https address Chapa can call back. In production this is the SAME domain as PUBLIC_URL (Caddy sends /api/* to the backend).
# Leave empty in local development unless you use ngrok.
API_PUBLIC_URL=

# ---------- First admin (created by npm run db:init if no users exist) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# ---------- Yango Fleet ----------
YANGO_API_KEY=
YANGO_CLIENT_ID=
YANGO_PARK_ID=

# ---------- SMS ----------
# playsms = real SMS through your PlaySMS server | console = prints the SMS in the server log (testing)
SMS_PROVIDER=playsms
# same values as your curl test (https://<host>:<port>/index.php, u=..., h=...)
PLAYSMS_URL=https://172.168.9.134:8080/index.php
PLAYSMS_USER=
PLAYSMS_TOKEN=
# true = accept the PlaySMS self-signed certificate (what curl -k does). Only used for PlaySMS.
PLAYSMS_INSECURE_TLS=true

# ---------- Chapa ----------
CHAPA_SECRET_KEY=

# ---------- PDF ----------
# Nothing to set: backend/Dockerfile installs Chromium and sets PUPPETEER_EXECUTABLE_PATH.